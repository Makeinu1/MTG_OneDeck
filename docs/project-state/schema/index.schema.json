{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-onedeck.local/project-state/index.schema.json",
  "title": "MTG OneDeck Canonical Project State Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","status","baseline","authorities","program","capabilities","pendingDecisions","ownerDecisions","roles","coldRestartAcceptance"],
  "properties": {
    "schemaVersion": {"const":1},
    "status": {"enum":["ACTIVE"]},
    "baseline": {"type":"object","additionalProperties":false,"required":["repository","branch","commit","auditedDate","watchedRoots"],"properties":{"repository":{"type":"string"},"branch":{"type":"string"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"auditedDate":{"type":"string"},"watchedRoots":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "authorities": {"type":"object"},
    "program": {"type":"object"},
    "capabilities": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","path"],"properties":{"id":{"type":"string","pattern":"^CR-[0-9]{2}$"},"path":{"type":"string"}}}},
    "pendingDecisions": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","traceabilityRefs","acceptanceRefs","summary","nextAction"],"properties":{"id":{"type":"string","pattern":"^CONFLICT-[A-Z0-9-]+$"},"status":{"enum":["PENDING_JUDGMENT","OWNER_REQUIRED"]},"traceabilityRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"acceptanceRefs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"summary":{"type":"string","minLength":1},"nextAction":{"type":"string","minLength":1}}}},
    "ownerDecisions": {"type":"array","items":{"type":"object"}},
    "roles": {"type":"object"},
    "coldRestartAcceptance": {"type":"string"}
  }
}
