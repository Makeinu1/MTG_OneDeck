{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-onedeck.local/project-state/index.schema.json",
  "title": "MTG OneDeck Canonical Project State Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","status","baseline","authorities","program","coverage","capabilities","pendingDecisions","ownerDecisions","roles","coldRestartAcceptance"],
  "properties": {
    "schemaVersion": {"const":2},
    "status": {"enum":["ACTIVE"]},
    "baseline": {"type":"object","additionalProperties":false,"required":["repository","branch","commit","auditedDate","watchedRoots"],"properties":{"repository":{"type":"string"},"branch":{"type":"string"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"auditedDate":{"type":"string"},"watchedRoots":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "authorities": {"type":"object"},
    "program": {"type":"object"},
    "coverage": {"type":"object","additionalProperties":false,"required":["mode","scope","completenessSources","knownLimitations"],"properties":{"mode":{"const":"BOUNDED"},"scope":{"type":"string","minLength":1},"completenessSources":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"knownLimitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
    "capabilities": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","path"],"properties":{"id":{"type":"string","pattern":"^CR-[0-9]{2}$"},"path":{"type":"string"}}}},
    "pendingDecisions": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","traceabilityRefs","acceptanceRefs","summary","nextAction"],"properties":{"id":{"type":"string","pattern":"^CONFLICT-[A-Z0-9-]+$"},"status":{"enum":["PENDING_JUDGMENT","OWNER_REQUIRED"]},"traceabilityRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"acceptanceRefs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"summary":{"type":"string","minLength":1},"nextAction":{"type":"string","minLength":1},"ownerDecisionRef":{"type":"string","pattern":"^OD-[0-9]{3}$"}},"allOf":[{"if":{"properties":{"status":{"const":"OWNER_REQUIRED"}},"required":["status"]},"then":{"required":["ownerDecisionRef"]}},{"if":{"properties":{"status":{"const":"PENDING_JUDGMENT"}},"required":["status"]},"then":{"not":{"required":["ownerDecisionRef"]}}}]}},
    "ownerDecisions": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","summary"],"properties":{"id":{"type":"string","pattern":"^OD-[0-9]{3}$"},"status":{"enum":["OPEN","RESOLVED"]},"decision":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},"decidedDate":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"status":{"const":"RESOLVED"}},"required":["status"]},"then":{"required":["decision","decidedDate"]}},{"if":{"properties":{"status":{"const":"OPEN"}},"required":["status"]},"then":{"not":{"anyOf":[{"required":["decision"]},{"required":["decidedDate"]}]}}}]}},
    "roles": {"type":"object"},
    "coldRestartAcceptance": {"type":"string"}
  }
}
